#!/bin/sh
# A post-tool hook (README, «Хуки»): hides AWS access key IDs and GitHub
# tokens in a tool's result before the agent records it. aish masks these,
# and more, in what it sends to the model anyway (mask_defaults); a hook
# keeps a secret out of the session's journal too, and is the place for
# patterns and rules of your own. Copy it to ~/.config/aish/hooks/post-tool/.
# Needs jq.
exec jq -c '
	.output as $out
	| ($out
		| gsub("AKIA[0-9A-Z]{16}"; "AKIA***")
		| gsub("ghp_[A-Za-z0-9]{36}"; "ghp_***")) as $masked
	| if $masked == $out then empty else {output: $masked} end'
